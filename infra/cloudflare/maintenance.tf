# The maintenance Worker answers every request to the apex until the homepage
# cutover (P3) removes this binding; the Worker's DNS record (AAAA 100::) is
# generated by this binding and is not managed separately. The Worker script is
# not managed here; a recovery copy is kept under deploy/recovery/ (Git-ignored).
resource "cloudflare_workers_custom_domain" "apex_maintenance" {
  account_id = data.cloudflare_zone.saberu.account.id
  zone_id    = data.cloudflare_zone.saberu.id
  hostname   = "saberu.com"
  service    = "down-page"
}
